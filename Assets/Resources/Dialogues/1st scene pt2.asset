    choice:
      options: []
    flagAction:
      flagName: 
      newValue: 0
  - nodeType: 0
    dialogueLine:
      speakerName: Burlone
      text: "\xBFHar\xE1s algo malo Ben? \xBFQu\xE9 har\xE1s?..."
