    choice:
      options: []
    flagAction:
      flagName: 
      newValue: 0
  - nodeType: 0
    dialogueLine:
      speakerName: Aurora
      text: "Ok... Las facturas del local ya hay que pagarlas, y con c\xF3mo hemos
