      rightPortrait: {fileID: 21300000, guid: ab26f63d67279e24a9c25b6ec796f7ef, type: 3}
    condition:
      flagName: 
      expectedValue: 0
      trueContinueCurrent: 0
      trueNextDialogue: {fileID: 0}
      falseContinueCurrent: 0
      falseNextDialogue: {fileID: 0}
    choice:
      options: []
    flagAction:
      flagName: 
      newValue: 0
  - nodeType: 0
    dialogueLine:
      speakerName: ???
      text: "Pobre Ben, te ves fatal... \xBFProblemas al dormir?"
      leftPortrait: {fileID: 21300000, guid: 677541715f37e49458209212f538fa8b, type: 3}
      rightPortrait: {fileID: 0}
    condition:
      flagName: 
      expectedValue: 0
