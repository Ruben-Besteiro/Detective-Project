  - nodeType: 0
    dialogueLine:
      speakerName: ????
      text: JAJAJAJAJA, Te pillaroooooonnnn.
      leftPortrait: {fileID: 21300000, guid: 677541715f37e49458209212f538fa8b, type: 3}
      rightPortrait: {fileID: 21300000, guid: ab26f63d67279e24a9c25b6ec796f7ef, type: 3}
    condition:
      flagName: 
