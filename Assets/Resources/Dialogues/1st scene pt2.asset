    choice:
      options: []
    flagAction:
      flagName: 
      newValue: 0
  - nodeType: 0
    dialogueLine:
      speakerName: Benny
      text: "He estado muy cansado, y el hecho de no dormir ya est\xE1 pasando factura.
        \xBFPodr\xEDas repetirlo una \xFAltima vez?"
      leftPortrait: {fileID: 21300000, guid: 677541715f37e49458209212f538fa8b, type: 3}
      rightPortrait: {fileID: 21300000, guid: ab26f63d67279e24a9c25b6ec796f7ef, type: 3}
    condition:
      flagName: 
