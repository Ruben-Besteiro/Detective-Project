      trueNextDialogue: {fileID: 0}
      falseContinueCurrent: 0
      falseNextDialogue: {fileID: 0}
    choice:
      options: []
    flagAction:
      flagName: 
      newValue: 0
  - nodeType: 0
    dialogueLine:
      speakerName: Benny
      text: '[baja la voz, Burlone, que me cansas con solo respirar]'
      leftPortrait: {fileID: 21300000, guid: 677541715f37e49458209212f538fa8b, type: 3}
      rightPortrait: {fileID: 0}
    condition:
      flagName: 
      expectedValue: 0
      trueContinueCurrent: 0
      trueNextDialogue: {fileID: 0}
      falseContinueCurrent: 0
      falseNextDialogue: {fileID: 0}
    choice:
      options: []
    flagAction:
      flagName: 
      newValue: 0
  - nodeType: 0
    dialogueLine:
      speakerName: Burlone
      text: "Ay, pero que llorica... \xBFY que pasar\xE1 si no me quedo quieto?"
      leftPortrait: {fileID: 21300000, guid: 677541715f37e49458209212f538fa8b, type: 3}
      rightPortrait: {fileID: 0}
    condition:
      flagName: 
